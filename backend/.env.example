# ---- App ----
ENV=dev
AUTO_CREATE_TABLES=true          # dev convenience; use Alembic (false) in prod

# ---- Database ----
# Local/dev default is SQLite (no server needed):
DATABASE_URL=sqlite:///./resume_screener.db
# Production example (Postgres):
# DATABASE_URL=postgresql+psycopg2://resume:resume@localhost:5432/resume_screener

# ---- Cache ----
# Leave unset to use an in-process cache. For Redis:
# REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- File uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- LLM ----
# 'mock' runs fully offline (no key needed). Switch to 'anthropic' or 'openai'.
LLM_PROVIDER=mock
LLM_MAX_RETRIES=2
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- Scoring weights (must be considered together) ----
SIMILARITY_WEIGHT=0.4
LLM_WEIGHT=0.6
