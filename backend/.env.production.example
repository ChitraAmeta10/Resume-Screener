# ============================================================
#  PRODUCTION / DEPLOY env  (Render, Railway, Fly, or Vercel)
#  Set these as Environment Variables in your host's dashboard.
#  Do NOT commit real values — this .example file is a template.
# ============================================================

ENV=prod
# Run Alembic migrations once instead of auto-creating tables:
AUTO_CREATE_TABLES=false

# ---- Database (REQUIRED — SQLite will NOT work on serverless) ----
# Use a hosted Postgres (Neon, Supabase, Vercel Postgres, Railway).
# IMPORTANT: SQLAlchemy needs the 'postgresql+psycopg2://' prefix,
# and on serverless use the POOLED connection string.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ---- Auth ----
JWT_SECRET=sCu_o-pUdBBIRdVmllyNjAMA8KNkFLCHhjE8f3aZ9-sfgY3VHimUKbCIGrM32wkq
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS (set to your deployed frontend origin; JSON list) ----
CORS_ORIGINS=["https://your-frontend.vercel.app"]

# ---- File uploads (only /tmp is writable on serverless; ephemeral) ----
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_MB=10


# ---- Document store (MongoDB — raw resume artifacts) ----
# Hosted free tier: MongoDB Atlas. Use the SRV connection string.
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=resume_screener

# ---- Cache (optional; use a hosted Redis like Upstash for serverless) ----
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

# ---- LLM ----
# 'mock' works with no key. For real scoring set a provider + key:
LLM_PROVIDER=mock
LLM_MAX_RETRIES=2
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# ---- Scoring weights ----
SIMILARITY_WEIGHT=0.4
LLM_WEIGHT=0.6
